{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmetbysoy/youtube_shorts_automation/blob/main/schemas/gemini_story_response.schema.json",
  "title": "Gemini Web grounded Shorts response",
  "description": "Raw JSON response contract used only by the publication-free Gemini Web draft probe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_source_id",
    "topic",
    "title",
    "description",
    "hook",
    "script_text",
    "cta_line",
    "thumbnail_prompt",
    "viral_hashtags",
    "claims",
    "storyboard"
  ],
  "properties": {
    "topic_source_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 2, "maxLength": 120},
    "title": {"type": "string", "minLength": 8, "maxLength": 100},
    "description": {"type": "string", "minLength": 8, "maxLength": 1200},
    "hook": {"type": "string", "minLength": 5, "maxLength": 240},
    "script_text": {"type": "string", "minLength": 200, "maxLength": 1600},
    "cta_line": {"type": "string", "minLength": 4, "maxLength": 180},
    "thumbnail_prompt": {"type": "string", "minLength": 8, "maxLength": 1000},
    "affiliate_hook": {"type": "string", "maxLength": 300},
    "viral_hashtags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "pattern": "^#[A-Za-zÇĞİÖŞÜçğıöşü0-9_]+$"}
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "script_span", "evidence_quote"],
        "properties": {
          "claim": {"type": "string", "minLength": 8, "maxLength": 300},
          "script_span": {"type": "string", "minLength": 8, "maxLength": 500},
          "evidence_quote": {"type": "string", "minLength": 25, "maxLength": 500}
        }
      }
    },
    "storyboard": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "narration", "visual_query", "alternative_queries"],
        "properties": {
          "scene_id": {"type": "integer", "minimum": 1},
          "narration": {"type": "string", "minLength": 8, "maxLength": 500},
          "visual_query": {"type": "string", "minLength": 8, "maxLength": 160},
          "alternative_queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 5, "maxLength": 160}
          }
        }
      }
    }
  }
}
