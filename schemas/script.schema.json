{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmetbysoy/youtube_shorts_automation/blob/main/schemas/script.schema.json",
  "title": "YouTube Shorts script.json",
  "description": "Legacy v1 payloads remain readable; new producer payloads use v2 metadata.",
  "oneOf": [
    {
      "$ref": "#/$defs/legacyV1"
    },
    {
      "$ref": "#/$defs/currentV2"
    }
  ],
  "$defs": {
    "wordTimestamp": {
      "type": "object",
      "required": [
        "word",
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "word": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "end_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "supports_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "claim",
        "status"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "verified",
            "partially_verified",
            "unverified",
            "rejected"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": [
        "scene_id",
        "narration",
        "visual_query"
      ],
      "properties": {
        "scene_id": {
          "type": "integer",
          "minimum": 1
        },
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "end_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "visual_query": {
          "type": "string",
          "minLength": 1
        },
        "alternative_queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_prompt": {
          "type": "string"
        },
        "media_type": {
          "enum": [
            "video",
            "image",
            "animation",
            "generated"
          ]
        }
      },
      "additionalProperties": true
    },
    "common": {
      "type": "object",
      "required": [
        "generated_at",
        "llm_provider",
        "tts_engine",
        "topic",
        "title",
        "description",
        "hook",
        "script_text",
        "word_count",
        "audio_file",
        "srt_file",
        "audio_duration_sec",
        "visual_keywords",
        "word_timestamps"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "llm_provider": {
          "type": "string",
          "minLength": 1
        },
        "tts_engine": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "affiliate_link": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "affiliate_cta": {
          "type": [
            "string",
            "null"
          ]
        },
        "cta_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnail_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "viral_hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "script_text": {
          "type": "string",
          "minLength": 1
        },
        "word_count": {
          "type": "integer",
          "minimum": 1
        },
        "audio_file": {
          "type": "string",
          "minLength": 1
        },
        "srt_file": {
          "type": "string",
          "minLength": 1
        },
        "audio_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "visual_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "word_timestamps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wordTimestamp"
          }
        }
      },
      "additionalProperties": true
    },
    "legacyV1": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "not": {
            "required": [
              "schema_version"
            ]
          }
        }
      ],
      "properties": {
        "schema_version": false
      }
    },
    "currentV2": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "schema_version",
        "generation_id"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "fact_check": {
          "type": "object",
          "required": [
            "status",
            "claims"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "partial",
                "failed",
                "not_run"
              ]
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/claim"
              }
            },
            "checked_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        },
        "storyboard": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scene"
          }
        }
      }
    }
  }
}
