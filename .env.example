# Şablon dosyasıdır. Gerçek anahtarları yalnızca .env veya GitHub Secrets içine yazın!
# Google Cloud OAuth 2.0 (Google urn:ietf:wg:oauth:2.0:oob akışını kapattığı için http://localhost:8080/ kullanılır)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/

# YouTube API
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
YOUTUBE_TOKEN_FILE=./token.json
YOUTUBE_PRIVACY_STATUS=private

# Ücretsiz LLM Sağlayıcıları
GROQ_API_KEY=
GEMINI_API_KEY=

# Stok Medya API Anahtarları
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Ortam ve Log Ayarları
OUTPUT_DIR=./output
ENVIRONMENT=development
LOG_LEVEL=INFO
