# Şablon dosyasıdır. Gerçek anahtarları yalnızca .env veya GitHub Secrets içine yazın!
# Google Cloud OAuth 2.0 (Google urn:ietf:wg:oauth:2.0:oob akışını kapattığı için http://localhost:8080/ kullanılır)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/

# YouTube API
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
YOUTUBE_TOKEN_FILE=./token.json
YOUTUBE_PRIVACY_STATUS=private

# Ücretsiz LLM Sağlayıcıları
GROQ_API_KEY=
GEMINI_API_KEY=

# Stok Medya API Anahtarları
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Faz 5–7: Playwright YouTube Studio Oturum ve Matris Ayarları (Yalnızca .env / GitHub Secrets içinde tutulur!)
YT_EMAIL=
YT_PASSWORD=
# Paralel matris kanal kimliği (1, 2, 3... - çakışmasız senaryo ve kademeli başlatma için)
MATRIX_CHANNEL_ID=1

# Faz 9: Konu Bazlı Monetizasyon / Affiliate Linkleri (Boş bırakılırsa kanal abonelik linki kullanılır)
AFFILIATE_URL_SPACE=
AFFILIATE_URL_HISTORY=
AFFILIATE_URL_SCIENCE=
AFFILIATE_URL_DEFAULT=

# Faz 10: Otonom "Ölü Ağırlık" Temizleyici (Auto-Pruner) Eşikleri
# Bu degerler "saatlik_low_view_pruner" iş akışı tarafından GitHub Secrets/Vars üzerinden ezilebilir.
PRUNE_MIN_VIEWS=100            # Bu izlenmenin altındaki videolar "ölü ağırlık" sayılır
PRUNE_MIN_AGE_MINUTES=60       # Video en az bu kadar dakika eski olmalı (ilk 1 saat korunur)
PRUNE_MAX_DELETIONS=10         # Tek çalıştırmada silinecek en fazla video
PRUNE_MIN_REMAINING=1          # Kanalda bırakılacak en az video sayısı
PRUNE_DRY_RUN=false            # true ise yalnızca raporlar, silmez

# Ortam ve Log Ayarları
OUTPUT_DIR=./output
ENVIRONMENT=development
LOG_LEVEL=INFO
