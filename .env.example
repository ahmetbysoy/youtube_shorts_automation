# Example only. Put real values in .env or your runtime's secret store.
# Never upload real credentials, access tokens or refresh tokens to Drive/GitHub.
GROQ_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
OUTPUT_DIR=./output
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
# Public publishing will require a separate explicit approval step.
YOUTUBE_PRIVACY_STATUS=private
